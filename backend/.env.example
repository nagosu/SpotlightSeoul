# ----------------------------
# docker-compose(MySQL) 용
# - docker-compose.yml은 MYSQL_*만 사용
# - 필요 시 로컬 .env에 같이 두어도(DB_*와 키가 달라) 충돌하지 않음
# ----------------------------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=pass
MYSQL_DATABASE=seoul

# ----------------------------
# Nest(TypeORM) 용
# - Nest는 로컬에서 실행되므로 DB_HOST는 localhost 사용(컨테이너 호스트명 사용 X)
# - DB_SCHEMA는 보통 MYSQL_DATABASE와 동일하게 둔다
# ----------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=pass
DB_SCHEMA=seoul

# ----------------------------
# Auth(JWT)
# ----------------------------
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_MINUTES=30
JWT_REFRESH_EXPIRES_DAYS=30
AUTH_HEADER=Authorization

# ----------------------------
# Seoul Open API
# ----------------------------
SEOUL_OPEN_API_KEY=change-me
SEOUL_OPEN_API_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_OPEN_API_DATASET=culturalEventInfo
SEOUL_OPEN_API_CHUNK_SIZE=999

# ----------------------------
# Phase F toggles (dev/test)
# ----------------------------
OPEN_DATA_ENABLED=true
SCHEDULER_ENABLED=true

# ----------------------------
# Phase G (ops)
# ----------------------------
SEOUL_OPEN_API_TIMEOUT_MS=10000
SEOUL_OPEN_API_MAX_RETRIES=3
SEOUL_OPEN_API_RETRY_BASE_DELAY_MS=300
FESTIVAL_COORDS_SWAP_MODE=legacy
FESTIVAL_COUNTER_UPDATE_MODE=entity
ADMIN_STATUS_ENABLED=false
