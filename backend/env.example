# NOTE
# - 이 작업 환경에서는 '.env.example'처럼 점(.)으로 시작하는 파일 생성이 차단될 수 있어,
#   우선 'env.example'로 추가했습니다.
# - 서버(EC2)에서는 아래처럼 복사해서 사용하세요:
#   cp env.example .env

# =========================
# App
# =========================
NODE_ENV=production
TZ=Asia/Seoul

# =========================
# MySQL (docker compose)
# =========================
MYSQL_ROOT_PASSWORD=change-me-strong
MYSQL_DATABASE=seoul

# =========================
# DB (NestJS / TypeORM)
# - compose 내부에서는 mysql 서비스명으로 접근해야 합니다.
# =========================
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me-strong
DB_SCHEMA=seoul

# =========================
# Feature toggles
# =========================
OPEN_DATA_ENABLED=true
SCHEDULER_ENABLED=true

# =========================
# Auth / JWT
# =========================
JWT_SECRET=change-me-long-random
JWT_ACCESS_EXPIRES_MINUTES=30
JWT_REFRESH_EXPIRES_DAYS=30
AUTH_HEADER=Authorization

# =========================
# Seoul Open API
# =========================
SEOUL_OPEN_API_KEY=
SEOUL_OPEN_API_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_OPEN_API_DATASET=culturalEventInfo
SEOUL_OPEN_API_CHUNK_SIZE=999

